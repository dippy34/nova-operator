{
  "name": "nova-operator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nova Phase 1 safe vertical slice: Mac core + native iPhone client",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node core/server.mjs",
    "pair": "node core/cli.mjs pair",
    "resume": "node core/cli.mjs resume",
    "diagnostics": "node core/cli.mjs diagnostics",
    "service:install": "node core/service.mjs install",
    "service:status": "node core/service.mjs status",
    "service:remove": "node core/service.mjs remove",
    "operator:build": "node macos/build.mjs",
    "operator:package": "node macos/package.mjs",
    "package:check": "node macos/package-check.mjs",
    "operator:install": "node macos/install.mjs install",
    "operator:status": "node macos/install.mjs status",
    "operator:remove": "node macos/install.mjs remove",
    "computer:owner": "node macos/owner.mjs",
    "test": "node --test core/*.test.mjs macos/*.test.mjs"
  }
}
